<?xml version="1.0" encoding="UTF-8"?>
<!--
  The SEO cycle, scheduled on a host that HAS the site checkout.

  This is a launchd job rather than an entry in the agent's own cron because `seo_publish` needs a
  git checkout, the site's npm toolchain and a `gh` that can open a PR — none of which exist in the
  API's runtime. Scheduling it there would produce a job that looks healthy and logs `no_repo`
  forever. See scripts/run_seo_cycle.py.

  It ships INERT: `AGENT_SEO_ENABLED` defaults to false, so until that is set the job runs, records
  PR outcomes (`settle`, which is useful on its own) and declines to publish.

  Install:   cp deploy/com.meshpilot.seo-cycle.plist ~/Library/LaunchAgents/
             launchctl load ~/Library/LaunchAgents/com.meshpilot.seo-cycle.plist
  Remove:    launchctl unload ~/Library/LaunchAgents/com.meshpilot.seo-cycle.plist
  Run now:   launchctl start com.meshpilot.seo-cycle
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.meshpilot.seo-cycle</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/tejaskaranagrawal/.local/bin/uv</string>
    <string>run</string><string>python</string>
    <string>scripts/run_seo_cycle.py</string>
  </array>

  <!-- The repo's own .env is read relative to the working directory. -->
  <key>WorkingDirectory</key>
  <string>/Users/tejaskaranagrawal/dev/meshpilot-social-media-agent</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- node/npm live under ~/.local/node/bin here, NOT ~/.local/bin. launchd does not read a
         shell profile, so a PATH that merely looks plausible fails the site's gates with
         "npm: not found" — and the first run never caught it, because the kill-switch refused
         before the gates ran. -->
    <key>PATH</key>
    <string>/Users/tejaskaranagrawal/.local/bin:/Users/tejaskaranagrawal/.local/node/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>GE_SEO_REPO_PATH</key>
    <string>/Users/tejaskaranagrawal/dev/glitch-executor/glitch-trade-app</string>
    <key>GE_SEO_AUDIENCE</key>
    <string>traders evaluating or running prop-firm challenges</string>
    <!-- Commits by anyone else on the PR branch count as human edits, which is what gates
         promotion out of S0. Get this wrong and the agent never earns autonomy, or earns it
         falsely. -->
    <key>GE_SEO_AGENT_LOGINS</key>
    <string>floating-astronaut</string>
    <!-- ARMED 2026-09-02. At S0 this opens a PR for a human to merge; it cannot self-merge until
         the track record earns S1. Unset this to stand it down — settle keeps running. -->
    <key>AGENT_SEO_ENABLED</key>
    <string>true</string>
    <!-- The PAT's permissions were widened 2026-09-02; both calls that previously failed now pass
         (GraphQL repository.defaultBranchRef, and reading refs/heads/main). Using it makes the job
         independent of this Mac's `gh` keyring, which a LaunchAgent cannot be relied on to reach. -->
    <key>SEO_USE_GITHUB_TOKEN</key>
    <string>true</string>
    <!-- What a post may claim about US. Derived from the code on 2026-09-03, not from the
         marketing site — see docs/vendors/seo.md for what is left out and why. A sentence naming
         the brand that matches none of these is rejected before publish.
         Order routing and the pre-broker block are LIVE as of 2026-09-03 (ge-prod-trade-api:12,
         TRADE_EXEC_BROKER_ROUTING_ENABLED=true, TRADE_EXEC_FEATURE_FLAG=true) — but
         TRADE_EXEC_DEMO_ONLY is NOT set, so it keeps its code default (true) and only accounts with
         is_live=false route. The "on demo accounts" qualifier is therefore load-bearing, not
         hedging: it forces the word "demo" to appear in any sentence claiming routing, because the
         matcher requires every content word. DROP the qualifier when demo-only is lifted (a live
         account also needs exec_live_opt_in), and not before. -->
    <key>GE_SEO_BRAND_TERMS</key>
    <string>Glitch Executor,GlitchExecutor,our engine,our platform</string>
    <key>GE_SEO_CAPABILITIES</key>
    <string>records each firm's published rules,dated source for every firm rule,compares firms side by side,calculates drawdown against a firm's rules,tracks account equity,daily-loss and drawdown evaluation,trade journal,replay,alerts,backtest,strategy builder,connects to cTrader,connects to DXtrade,connects to MetaApi,routes orders to your broker on demo accounts,places orders on demo accounts,submits trades on demo accounts,blocks an order before it reaches the broker on demo accounts,pre-trade rule check,order routing</string>
  </dict>

  <!-- 06:40 local. After the site's own nightly audit, and well clear of the agent's 03:00-03:30
       cloud jobs so a failure is attributable to one of them. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>

  <key>StandardOutPath</key><string>/tmp/meshpilot-seo-cycle.log</string>
  <key>StandardErrorPath</key><string>/tmp/meshpilot-seo-cycle.log</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
